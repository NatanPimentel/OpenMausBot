+
+    const mainIds = (await notifications()).filter((entry) => entry.threadId === main).map((entry) => entry.id);
+    await api("POST", `/api/bots/${botId}/read`, { threadId: main });
+    const frame = await stream.until((candidate) => candidate.kind === "notifications.read" && candidate.threadId === main, 10_000);
+    expect(frame.ids).toEqual(mainIds);
+    const after = await notifications();
+    expect(after.filter((entry) => entry.threadId === main).every((entry) => entry.read)).toBe(true);
+    expect(after.filter((entry) => entry.threadId === loudHook.threadId && !entry.read)).toHaveLength(1);
+
+    await api("POST", `/api/bots/${botId}/tasks/${loudHook.threadId}?messages=0`);
+    await stream.until((candidate) => candidate.kind === "notifications.read" && candidate.threadId === loudHook.threadId, 10_000);
+    expect((await notifications()).filter((entry) => entry.threadId === loudHook.threadId).every((entry) => entry.read)).toBe(true);
+  } finally {
+    stream.close();
+    await fixture.close();
+  }
+}, 120_000);
